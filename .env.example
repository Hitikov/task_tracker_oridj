# Arij — пример локальной конфигурации.
#
# Скопируйте файл в .env и замените значения:
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
#
# .env содержит локальные значения и не коммитится (см. .gitignore).
# docker compose читает .env автоматически; без него запуск завершится ошибкой.
#
# Значения ниже предназначены только для локальной разработки.
# В production задайте собственные стойкие пароли и секреты через переменные
# окружения или секрет-менеджер, а не через этот файл.

# --- HTTP-сервер ---
# Адрес, на котором слушает Dart-сервер. 0.0.0.0 — доступен снаружи контейнера.
SERVER_HOST=0.0.0.0
# Порт сервера на хосте. Внутри контейнера сервер всегда слушает 8080.
SERVER_PORT=8080

# --- PostgreSQL ---
# Хост PostgreSQL для запуска сервера на хосте (без Docker).
# В docker compose сервер получает DB_HOST=postgres из docker-compose.yml.
DB_HOST=localhost
# Порт PostgreSQL на хосте. Внутри docker-сети используется 5432.
DB_PORT=5432
DB_NAME=arij
DB_USER=arij
# Пароль только для локальной разработки. В production используйте стойкий пароль.
DB_PASSWORD=arij_dev_password

# --- JWT ---
# ОБЯЗАТЕЛЬНО замените placeholder на случайную строку не короче 32 символов.
# Сгенерировать:
#   openssl rand -hex 32
#   PowerShell: -join (1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# В production секрет хранится только в окружении или секрет-менеджере.
JWT_SECRET=CHANGE_ME_generate_a_random_secret_with_openssl_rand_hex_32
