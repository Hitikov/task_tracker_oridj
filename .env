# =====================================
# Database Connection Settings for PostgreSQL
# !!! ВНИМАНИЕ: Замените эти значения на реальные секреты и пароли вашего сервера !!!
# =====================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_tracker_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here 

# Ключ, используемый для защиты API-вызовов (если будет реализована аутентификация)
API_SECRET_KEY=a-very-strong-random-secret-key-12345
